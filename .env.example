# ==============================================================================
# AGENTIC AI ADAPTIVE PQC SMART DOOR LOCK - CONFIGURATION
# ==============================================================================

# Direct LAN REST API. Set this to the Windows PC's Wi-Fi IPv4 address; the
# ESP8266 must not use 127.0.0.1.
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_LAN_IP=10.180.113.12
FLASK_BACKEND_URL=http://10.180.113.12:5000
DEVICE_API_BASE_URL=http://10.180.113.12:5000
DEVICE_API_USE_HTTPS=false

# Must match DEVICE_TOKEN in esp8266/smart_door_esp8266/secrets.h.
# Use a long random value outside a controlled demonstration.
DEVICE_ID=DOOR-001
DEVICE_SECRET=DOOR_PQC_SECURE_TOKEN_2026

# Google Sheets is optional export only; it is not on the operational path.
ENABLE_GOOGLE_SHEETS_EXPORT=false
GOOGLE_SPREADSHEET_ID=
GOOGLE_SCRIPT_URL=
GOOGLE_CREDENTIALS_FILE=
